 "components": {
  "schemas": {
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ImportIn": {
    "properties": {
     "source": {
      "type": "string",
      "pattern": "^demo-archive$",
      "title": "Source",
      "description": "The one connector in this build: a deterministic synthetic export of photos, mail, calendar, receipts and messages",
      "default": "demo-archive"
     }
    },
    "type": "object",
    "title": "ImportIn"
   },
   "SearchIn": {
    "properties": {
     "query": {
      "type": "string",
      "maxLength": 400,
      "minLength": 2,
      "title": "Query"
     },
     "k": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 1.0,
      "title": "K",
      "default": 8
     },
     "kinds": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array",
        "maxItems": 6
       },
       {
        "type": "null"
       }
      ],
      "title": "Kinds"
     }
    },
    "type": "object",
    "required": [
     "query"
    ],
    "title": "SearchIn"
   },
   "SummarizeIn": {
    "properties": {
     "event_id": {
      "type": "string",
      "format": "uuid",
      "title": "Event Id"
     }
    },
    "type": "object",
    "required": [
     "event_id"
    ],
    "title": "SummarizeIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
